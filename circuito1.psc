Algoritmo circuito1
	Definir p,q Como Logico
	
	Escribir "Ingresa el valor de p: "
	Leer p
	Escribir "Ingresa el valor de q: "
	Leer q
	
	Escribir "p,q, p AND q, NOT q, (p AND q) OR (NOT q)" 
	Escribir p,"-",q,"-", p y q,"-",no q, "-",(p y q) o (no q)
FinAlgoritmo
