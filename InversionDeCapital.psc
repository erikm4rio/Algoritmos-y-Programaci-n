//Una persona invierte su capital en un banco y desea saber cua?nto dinero ganara? despue?s de un mes si la entidad paga a razo?n del 2 % mensual.
Algoritmo InversionDeCapital
	//Definir
	Definir InversionInicial Como Entero
	Definir Resultado Como Real
	
	//Entrada
	Escribir "Ingresa tu inverión inicial: "
	Leer InversionInicial
	
	//Operaciones
	Resultado <- InversionInicial*1.02
	
	//Imprimir Resultado
	Imprimir "Resultado: ", Resultado
FinAlgoritmo
